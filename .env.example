# Neon Postgres connection string (Neon dashboard -> Connect)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Python roster engine (default: local `npm run engine`)
ENGINE_URL=http://127.0.0.1:8000
# Shared secret between website and engine. Set the SAME value on both in production; leave empty locally.
ENGINE_KEY=

# Signs the demo login cookie (any long random string). REQUIRED in production: the app refuses to run without it.
AUTH_SECRET=change-me-to-a-long-random-string

# Optional: AI assistant (Google Gemini, free tier at aistudio.google.com). App works without it.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Sign-in. The manager account comes from env; employees sign in with their email + password (scrypt-hashed in the DB).
MANAGER_EMAIL=manager@datastraw.demo
# REQUIRED in production (the app refuses to start sign-in without it). Locally it falls back to DEMO_PASSWORD.
MANAGER_PASSWORD=
# Password given to seeded employees by `npm run db:seed` / `npm run db:passwords`
DEMO_PASSWORD=demo1234
# Show the demo accounts box on the login page (keep on for reviewers; set to false for real use)
SHOW_DEMO_LOGINS=true
